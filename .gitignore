# Python
__pycache__/
*.pyc

# Run data (large: logs ~0.5 GB per 3 h, images ~125 MB/min when all saved)
runs/*
!runs/.gitkeep
gps_logs/

# Your own instrument: configs and calibration, built databases, webui settings
configs/*
!configs/README.md
data/
webui/webui_config.json

# Webui map tile cache
webui/tiles/
webui/tiles_download/
webui/*.log
